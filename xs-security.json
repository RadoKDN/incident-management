{
  "xsappname": "incident-management",
  "tenant-mode": "dedicated",
  "oauth2-configuration": {
    "redirect-uris": [
      "https://*.cfapps.us10.hana.ondemand.com/**",
      "https://*.cfapps.us10-001.hana.ondemand.com/**"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.support",
      "description": "Support role scope"
    },
    {
      "name": "$XSAPPNAME.admin",
      "description": "Admin role scope"
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "support",
      "description": "Support personnel - manage incidents",
      "scope-references": [
        "$XSAPPNAME.support"
      ],
      "attribute-references": []
    },
    {
      "name": "admin",
      "description": "Administrator - manage customers and incidents",
      "scope-references": [
        "$XSAPPNAME.admin"
      ],
      "attribute-references": []
    }
  ],
  "role-collections": [
    {
      "name": "incident-management-support",
      "description": "Incident Management Support",
      "role-template-references": [
        "$XSAPPNAME.support"
      ]
    },
    {
      "name": "incident-management-admin",
      "description": "Incident Management Admin",
      "role-template-references": [
        "$XSAPPNAME.admin"
      ]
    }
  ]
}
